# ── Database ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/imagify?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string

# ── ClipDrop (text-to-image AI) ──────────────────────────
CLIPDROP_API_KEY=your_clipdrop_api_key

# ── Razorpay (TEST MODE keys — free, no real money) ──────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# ── Misc ─────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
PORT=4000
